# Copy to .env and tweak if needed. Defaults work out of the box on 10.52.0.4.

# AIMIBO dongle LAN IP and mDNS name (fallback if DHCP IP ever changes)
AIMIBO_HOST=10.52.0.18
AIMIBO_PORT=7000
AIMIBO_NAME=Office Tv

# IP of the server hosting the HLS stream (auto-detected if left blank)
STREAM_HOST=10.52.0.4
HLS_HTTP_ADDR=:8899

# Leave blank to cast the built-in demo clock page.
# Set to your real dashboard URL once you build it (e.g. http://127.0.0.1:8090/).
TARGET_URL=

# Display / encoding tuning (15fps + 2s segments = smooth decode & ~4-6s latency)
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080
STREAM_FPS=15
HLS_SEGMENT_SEC=2
HLS_LIST_SIZE=3

# Audio capture (routes Chromium <audio> / Web Audio / TTS out through TV speakers)
ENABLE_AUDIO=true
AUDIO_BITRATE=128k

# Optional demo sound test: set to "once" (chimes 12s after start) or "loop" (every 20s)
DEMO_CHIME=
